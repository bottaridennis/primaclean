rules_version = '2';

// Regole di sicurezza per Prima Clean.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funzioni di supporto ----------
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn() && me().role == 'admin';
    }
    // Dipendente approvato e non sospeso
    function isActive() {
      return signedIn() && me().isApproved == true && me().isBlocked != true;
    }
    function inMyShop(shopId) {
      return shopId in me().shopIds;
    }

    // ---------- Utenti ----------
    match /users/{uid} {
      // Ognuno legge il proprio profilo; il personale attivo legge i colleghi (per mostrarne i nomi)
      allow read: if isSelf(uid) || isActive() || isAdmin();

      // Auto-registrazione: solo come dipendente in attesa, senza negozi né permessi
      allow create: if isSelf(uid)
        && request.resource.data.role == 'employee'
        && request.resource.data.isApproved == false
        && request.resource.data.isBlocked == false
        && request.resource.data.canSeeColleagues == false
        && request.resource.data.shopIds.size() == 0;

      // Approvazioni, ruoli, negozi, sospensioni ed eliminazioni: solo admin
      allow update, delete: if isAdmin();
    }

    // ---------- Negozi ----------
    match /shops/{shopId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- Turni ----------
    match /shifts/{shiftId} {
      allow read: if isAdmin()
        || (isActive() && inMyShop(resource.data.shopId)
            && (me().canSeeColleagues == true || resource.data.userId == request.auth.uid));

      allow create, delete: if isAdmin();

      // Scambio turni: il dipendente che accetta può cambiare solo l'assegnatario
      // di un turno del proprio negozio che cede o che riceve
      allow update: if isAdmin()
        || (isActive()
            && me().canSeeColleagues == true
            && inMyShop(resource.data.shopId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId'])
            && (resource.data.userId == request.auth.uid
                || request.resource.data.userId == request.auth.uid));
    }

    // ---------- Proposte di scambio ----------
    match /shiftExchanges/{exchangeId} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.requesterId == request.auth.uid
                           || resource.data.targetUserId == request.auth.uid));

      allow create: if isActive()
        && me().canSeeColleagues == true
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && inMyShop(request.resource.data.shopId);

      // Il richiedente può annullare, il destinatario accettare o rifiutare
      allow update: if isAdmin()
        || (signedIn()
            && (resource.data.requesterId == request.auth.uid
                || resource.data.targetUserId == request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['accepted', 'rejected']);

      allow delete: if isAdmin();
    }

    // ---------- Storico scambi ----------
    match /exchangeLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isActive();
      allow update, delete: if isAdmin();
    }
  }
}
